# SQLite is created automatically. PostgreSQL is optional.
# DATABASE_URL=postgres://saturn:saturn@localhost:5432/saturn
# SATURN_PROJECT=./project
# PORT=3000
# VAPID_SUBJECT=mailto:operator@example.com

# Optional text decisions in Terminal > Text. No provider is enabled by default.
# This configuration belongs to the Saturn host, never to the authored PLC project.
# SATURN_DECISION_PROVIDER=kev
# SATURN_DECISION_URL=http://127.0.0.1:8009/v1/systemone
# SATURN_DECISION_MODEL=kev-latest
# SATURN_DECISION_TIMEOUT_MS=60000

# Hosted presets: typesafe or vercel. Keep real keys out of Git.
# SATURN_DECISION_PROVIDER=vercel
# AI_GATEWAY_API_KEY=
# SATURN_DECISION_PROVIDER=typesafe
# TYPESAFE_API_KEY=
# SATURN_DECISION_API_KEY=  # explicit override; also usable with a custom compatible server
# Custom server: SATURN_DECISION_PROVIDER=custom, full SATURN_DECISION_URL, SATURN_DECISION_MODEL.
# Remote endpoints require HTTPS. The local URL is relative to the host machine, not the browser.
