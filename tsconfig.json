{
  "compilerOptions": {
    "target": "ESNext", "module": "Preserve", "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["bun"],
    "paths": { "@saturn/core": ["./src/core.ts"] }
  },
  "include": ["src", "project", "scripts", "tests"]
}
