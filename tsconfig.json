{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@saturn/core": [
        "./src/core.ts"
      ],
      "@saturn/example": [
        "../saturn-examples/pumping-station/project.ts"
      ],
      "@saturn/scada/acquisition": [
        "./src/runtime/acquisition.ts"
      ],
      "@saturn/protocols/*": [
        "../saturn-plugins/protocols/*"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "tests"
  ]
}
